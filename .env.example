# ==============================================================================
# ScribeNode Environment Configuration (.env)
# Copy this file to .env and configure your values before starting the application.
# ==============================================================================

# 🔑 REQUIRED: Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourActualGeminiApiKeyHere"

# 🌐 OPTIONAL: App Base URL
# Set this to the public address or LAN IP where ScribeNode is hosted.
# Default: http://localhost:3000
APP_URL="http://localhost:3000"

# 🔌 OPTIONAL: Server Port
# Default: 3000 (Or 4200, 8080, etc. if customized for homelab)
PORT=3000

# 🏷️ OPTIONAL: Custom Application Page Title
# Custom browser tab title (supports spaces and special characters)
# Default: ScribeNode – Transcription Engine
APP_TITLE="ScribeNode – Transcription Engine"

# 🔒 OPTIONAL: Private HTTP Basic Authentication
# Basic Auth is FULLY DISABLED by default.
# To explicitly enable authentication for private/homelab hosting, set BASIC_AUTH_ENABLED="true"
# AND provide both BASIC_AUTH_USER and BASIC_AUTH_PASS below.
BASIC_AUTH_ENABLED="false"
BASIC_AUTH_USER=""
BASIC_AUTH_PASS=""

# 📦 OPTIONAL: Disable Preseeded Example Items
# Defaults to false. If set to "true", preseeded example items ("Interview with Sarah Drabner") will NOT be automatically added on startup.
# Useful for clean Docker/homelab setups to keep only your own transcribed files across container rebuilds.
DISABLE_DEFAULT_ITEMS="false"

