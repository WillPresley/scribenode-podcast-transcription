{
  "name": "scribenode",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0",
    "body-parser": "^2.4.0",
    "deepmerge": "4.1.2",
    "fast-uri": "^4.2.3",
    "glob": "^14.0.3",
    "ip-address": "^10.7.4",
    "minimatch": "^11.0.4",
    "nanoid": "^3.3.17",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.1",
    "serialize-javascript": "^7.1.4",
    "source-map-js": "^1.2.2"
  },
  "allowScripts": {
    "@google/genai": true,
    "esbuild": true,
    "protobufjs": true
  }
}
